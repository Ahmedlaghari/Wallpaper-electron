{
  "name": "live-wallpaper",
  "version": "1.0.4",
  "description": "live wallapaper",
  "author": "Ahmed Ali Laghari",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.lagharibrothers.livewallpaper",
    "productName": "Live Wallpaper",
    "npmRebuild": true,
    "nodeGypRebuild": false,
    "extraResources": [
      {
        "from": "assets/fonts",
        "to": "fonts"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "artifactName": "Live-Wallpaper-Setup-${version}.${ext}"
    },
    "nsis": {
      "include": "installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "Ahmedlaghari",
      "repo": "Wallpaper-electron"
    }
  },
  "files": [
    "**/*",
    "!node_modules/.cache",
    "config.json",
    "icon.png"
  ],
  "asarUnpack": [
    "**/*.node",
    "node_modules/canvas/**",
    "node_modules/wallpaper/**",
    "node_modules/bindings/**",
    "node_modules/@napi-rs/**",
    "config.json",
    "icon.png",
    "fonts"
  ],
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "canvas": "^3.2.1",
    "electron-as-wallpaper": "^2.0.3",
    "electron-updater": "^6.8.3",
    "sharp": "^0.34.5",
    "wallpaper": "^7.2.1"
  }
}